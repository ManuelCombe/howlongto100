// Déploiement du rapport sur Cloudflare Workers (fichiers statiques uniquement).
// Utilisé par « python src/main.py deploy », qui copie d'abord output/rapport.html
// en output/site/index.html.
//
// L'accès à steam.camcc.fyi est restreint par Cloudflare Access (application
// « steam », règle « moi »), configuré dans le tableau de bord Zero Trust, pas ici.
{
  "name": "steam",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./output/site" },
  "routes": [{ "pattern": "steam.camcc.fyi", "custom_domain": true }],
  // Pas d'adresse *.workers.dev ni d'URL de prévisualisation :
  // elles ne seraient pas protégées par Access.
  "workers_dev": false,
  "preview_urls": false
}
